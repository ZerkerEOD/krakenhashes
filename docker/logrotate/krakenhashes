# The backend writes to stdout; supervisord owns these files and rotates them
# itself (stdout_logfile_maxbytes / stdout_logfile_backups). logrotate therefore
# uses copytruncate rather than renaming a file supervisord holds an fd on.
#
# There is deliberately NO postrotate signal here. The backend handles only
# SIGINT and SIGTERM, so SIGHUP would TERMINATE it -- an hourly outage. The old
# `supervisorctl signal HUP krakenhashes-backend` line was harmless only because
# supervisorctl had no socket to connect to; now that it does, the signal would
# actually be delivered.
/var/log/krakenhashes/backend/*.log {
    size 100M
    missingok
    rotate 20
    compress
    delaycompress
    notifempty
    copytruncate
    sharedscripts
}

/var/log/krakenhashes/nginx/*.log {
    size 100M
    missingok
    rotate 20
    compress
    delaycompress
    notifempty
    create 0640 www-data www-data
    sharedscripts
    postrotate
        supervisorctl signal HUP nginx || true
    endscript
}
