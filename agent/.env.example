# =============================================================================
# KrakenHashes Agent - Docker Environment Configuration
# =============================================================================
#
# Copy this file to .env and configure your settings:
#   cp .env.example .env
#
# Then start the agent:
#   docker-compose up -d
#
# =============================================================================

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Backend server hostname or IP address
# This is the KrakenHashes server the agent will connect to
KH_HOST=your-server.example.com

# Backend server port (default: 31337)
KH_PORT=31337

# =============================================================================
# REGISTRATION (Required for first run only)
# =============================================================================

# Claim code for agent registration
# Get this from: Admin UI -> Agents -> Manage Vouchers -> Create Voucher
# After successful registration, you can remove or comment out this line
KH_CLAIM_CODE=YOUR-CLAIM-CODE-HERE

# =============================================================================
# OPTIONAL: Logging
# =============================================================================

# Enable debug output (true/false)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# OPTIONAL: Hashcat Configuration
# =============================================================================

# Extra parameters to pass to hashcat for all jobs
# These are appended to the command line for every hashcat run
#
# Common options:
#   -O          Use optimized kernels (faster but may reduce max password length)
#   -w 3        Set workload profile (1=low, 2=default, 3=high, 4=nightmare)
#   --force     Ignore warnings (use with caution)
#
# Example: "-O -w 3"
# Note: Parameters set via the frontend UI take precedence
HASHCAT_EXTRA_PARAMS=

# =============================================================================
# OPTIONAL: GPU Selection (NVIDIA only)
# =============================================================================

# Which GPUs to expose to the container
# Run 'nvidia-smi -L' on the host to see available GPUs
#
# Options:
#   all         - Use all GPUs (default)
#   none        - Disable GPU access
#   0           - Use only GPU 0
#   0,1,2       - Use GPUs 0, 1, and 2
#   GPU-uuid    - Use specific GPU by UUID
#
NVIDIA_VISIBLE_DEVICES=all

# =============================================================================
# OPTIONAL: WebSocket Tuning
# =============================================================================
# Adjust these if experiencing connection issues

# WebSocket write timeout
KH_WRITE_WAIT=10s

# WebSocket pong wait timeout
KH_PONG_WAIT=60s

# WebSocket ping interval
KH_PING_PERIOD=54s

# =============================================================================
# OPTIONAL: File Transfer Settings
# =============================================================================

# Maximum concurrent downloads during file sync
KH_MAX_CONCURRENT_DOWNLOADS=3

# Timeout for large file downloads
KH_DOWNLOAD_TIMEOUT=1h

# Maximum download retries
KH_MAX_DOWNLOAD_RETRIES=3

# =============================================================================
# OPTIONAL: Storage Tier (network-share feature)
# =============================================================================
# How this agent obtains wordlists/rules. This is a SEED only: it sets the
# agent's initial tier/mount and is reported to the server at registration.
# Afterwards the admin UI (Admin -> System Settings -> Storage, per agent) is
# authoritative and can override it.
#
#   full_cache     - download over HTTP and keep everything (default)
#   on_demand      - download per task over HTTP, evict under disk pressure
#   network_direct - read wordlists/rules directly off a mounted share
#                    (ON-PREM ONLY; cloud agents cannot mount and use the relay)
KH_STORAGE_TIER=full_cache

# Read-only mount path used by the network_direct tier. You are responsible for
# mounting the share at this path before starting the agent (the agent never
# mounts anything itself). Ignored unless KH_STORAGE_TIER=network_direct.
# Example: /mnt/kh-agent-share
KH_NETWORK_SHARE_MOUNT_PATH=
