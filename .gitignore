# Common ignores
# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.*.local
# Timestamped backups written beside .env by tooling and by hand. The three
# patterns above do NOT match ".env.bak.20260908113906", so one of these sat
# untracked-but-unignored in the working tree carrying DB_PASSWORD, JWT_SECRET
# and SSO_ENCRYPTION_KEY, one `git add -A` away from being committed.
.env.bak*
.env.*.bak

# Development files
test_*.txt

# Cursor
.cursorignore
.cursorrules
.cursor/

# Claude Code
.claude/

# Frontend specific
# Node.js dependencies and build artifacts
node_modules/
frontend/node_modules/
npm-debug.log
frontend/npm-debug.log
yarn-error.log
frontend/yarn-error.log
/build/
frontend/build/

# Backend specific
# Go binaries and artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/vendor/
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib
backend/*.test
backend/*.out
backend/vendor/
backend/main
backend/server

# Go build directories
/bin/
/dist/
/build/
backend/bin/
backend/dist/
backend/build/

# Go debug files
*.test
*.prof
*.trace
*.cover
backend/**/*.test
backend/**/*.prof
backend/**/*.trace
backend/**/*.cover

# Certificate storage
/certs/
backend/certs/
.krakenhashes/

# Claude Code local settings (CLAUDE.md is committed; local .claude/ stays ignored)
.claude/

# Agent specific
# Go binaries
agent/agent
agent/main

# Logs
logs/
*.log

# Local development configuration
docker-compose.dev-local.yml

# Test files and directories
tests/ 
# Local Rafter false-positive suppression policy (not consumed by CI)
.rafter.yml

# Certificates the agent metrics integration test generates at run time. The
# test mints a fresh self-signed CA per run rather than carrying a fixture, so
# anything landing here is a build artifact.
agent/internal/metrics/integration_test/config/
